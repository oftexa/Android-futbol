{
  "name": "android-futbol-4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @af4/web typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "guardas": "tsx tools/guardas/src/cli.ts",
    "spec:split": "tsx tools/spec-split/src/cli.ts split",
    "spec:check": "tsx tools/spec-split/src/cli.ts check",
    "verify": "pnpm typecheck && pnpm lint && pnpm spec:check && pnpm test && pnpm --filter @af4/web test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
